{
  "套裝規則": {
    "說明": "當獵人蒐集並穿戴與該魔物對應之五件式防具（頭、胸、腕、腰、腳）成套，且五件皆為同一魔物套裝時，獵人出場立繪改為對應之獵人編號圖片。套裝基礎數值（僅指防具所提供之可加成項）依套裝星級累加：每1星級額外+2%（1星=+2%，2星=+4%，……，10星=+20%）。",
    "每星級基礎數值加成百分比": 2,
    "加成公式備註": "總加成百分比 = 套裝星級 × 每星級基礎數值加成百分比；星級以企劃該套防具之「星級」欄位為準（通常五件同星）。"
  },
  "未齊套裝預設": {
    "說明": "未達成任一魔物五件套裝之『齊套收集並穿戴』條件時，出場獵人立繪自下列編號對應圖檔隨機擇一。圖檔請放在 Unity 專案 Assets/Textures/Hunters/（執行時路徑見各列「隨機出場圖片路徑」）。",
    "隨機獵人編號": ["HUNTER_000_1", "HUNTER_000_2", "HUNTER_000_3", "HUNTER_000_4"],
    "隨機出場圖片路徑": [
      "Assets/Textures/Hunters/HUNTER_000_1.png",
      "Assets/Textures/Hunters/HUNTER_000_2.png",
      "Assets/Textures/Hunters/HUNTER_000_3.png",
      "Assets/Textures/Hunters/HUNTER_000_4.png"
    ]
  },
